# ─────────────────────────────────────────────────────────────────────────────
# recipe4you — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Pooled connection via PgBouncer — used at runtime by Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection — used for Prisma migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="eyJ..."           # Safe for browser — used by client SDK
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # SECRET — server only, never expose to browser

# ─── Supabase Storage Buckets ────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET_RECIPES="recipe-images"
SUPABASE_STORAGE_BUCKET_AVATARS="avatars"
STORAGE_MAX_FILE_SIZE_MB="10"

# ─── API Server (apps/api) ───────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
HOST="0.0.0.0"
API_BASE_URL="http://localhost:3001"
LOG_LEVEL="info"

# JWT secret — minimum 32 characters, use a random value
JWT_SECRET="change-me-to-a-random-32-char-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-to-another-random-32-char-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"

# App public URL (used in Stripe redirect URLs)
APP_URL="http://localhost:5173"

# CORS — comma-separated origins allowed to call the API
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
RATE_LIMIT_MAX="200"
RATE_LIMIT_WINDOW="1 minute"

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
# REST client (@upstash/redis) — used for caching and JWT revocation
UPSTASH_REDIS_REST_URL="https://[your-upstash-endpoint].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[your-upstash-token]"
# TCP connection (ioredis) — used by BullMQ queues and workers
# Upstash TCP endpoint: rediss://default:[token]@[host]:[port]
REDIS_URL="rediss://default:[your-upstash-token]@[your-upstash-host].upstash.io:6380"

# ─── Anthropic (Claude API) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PREMIUM="price_..."   # Monthly Premium subscription price ID

# ─── External Recipe APIs ────────────────────────────────────────────────────
SPOONACULAR_API_KEY="[your-spoonacular-key]"
EDAMAM_APP_ID="[your-edamam-app-id]"
EDAMAM_APP_KEY="[your-edamam-app-key]"

# ─── Frontend (apps/web) — must be prefixed VITE_ to be exposed to the browser
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."
VITE_API_BASE_URL="http://localhost:3001/api/v1"
VITE_SUPABASE_STORAGE_URL="https://[project-ref].supabase.co/storage/v1/object/public"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
